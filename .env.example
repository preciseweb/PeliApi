PORT=5555
NODE_ENV=development

# Protections disabled for personal/local use.
DISABLE_AUTH=true
DISABLE_RATE_LIMIT=true

# Request timeout (ms) when scraping PelisPlus.
REQUEST_TIMEOUT_MS=15000
MAX_HTML_BYTES=8388608

# Current Puppeteer setting. The legacy PUPPETEER_SKIP_CHROMIUM_DOWNLOAD remains supported.
PUPPETEER_SKIP_DOWNLOAD=true
MAX_CONCURRENT_PAGES=1
MAX_QUEUED_PAGES=8
PAGE_QUEUE_TIMEOUT_MS=5000
BROWSER_REQUEST_TIMEOUT_MS=25000

# Download engine settings.
DOWNLOADS_DIR=downloads
DOWNLOAD_REQUEST_TIMEOUT_MS=120000
DOWNLOAD_CONCURRENCY=1
DOWNLOAD_MAX_QUEUED=20
DOWNLOAD_HISTORY_LIMIT=200
DOWNLOAD_HISTORY_TTL_MS=86400000

# Use this when PelisPlus changes domain.
PELISPLUS_DOMAIN=https://www.pelisplushd.la
REPELISHD_DOMAIN=https://repelishd.ceo
CUEVANA_DOMAIN=https://ww9.cuevana3.to

# Debug download resolvers (true/false).
DEBUG_DOWNLOAD=false
